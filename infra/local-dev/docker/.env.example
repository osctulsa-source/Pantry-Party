# Template for infra/local-dev/docker/.env (which is gitignored).
# Copy this file: `cp .env.example .env` and fill in real values.
#
# These vars are consumed by docker-compose.yaml + service.yaml. After editing
# .env you MUST restart the powersync container to pick up changes:
#   docker compose -f docker-compose.yaml restart powersync
# (--build is not needed; the image doesn't change.)

PS_PORT=8080

PS_DATABASE_USER=postgres
PS_DATABASE_NAME=postgres
PS_DATABASE_PASSWORD=postgres
PS_DATABASE_PORT=5434

PS_STORAGE_USER=postgres
PS_STORAGE_DATABASE=postgres
PS_STORAGE_PASSWORD=postgres
PS_STORAGE_PORT=5435

PS_DATA_SOURCE_URI=postgresql://postgres:postgres@pg-db:5434/postgres
PS_STORAGE_SOURCE_URI=postgresql://postgres:postgres@pg-storage:5435/postgres

# Supabase JWKS endpoint for client auth (service.yaml client_auth.jwks_uri).
# Replace <project-ref> with the subdomain from EXPO_PUBLIC_SUPABASE_URL in
# apps/mobile/.env.local. Example: https://abcd1234.supabase.co/auth/v1/.well-known/jwks.json
PS_SUPABASE_JWKS_URI=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
