# EAS Build reads this from the monorepo root. Replicates .gitignore, but
# un-ignores apps/mobile/ios so EAS skips its buggy remote widget prebuild.
node_modules/
.pnp.*
dist/
build/
*.tsbuildinfo
.expo/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
android/
ios/
.env
.env.*
!.env.example
spikes/**/results/*.json
.powersync/
.DS_Store
*.log
.idea/
.vscode/*
!.vscode/extensions.json

!apps/mobile/ios/
!apps/mobile/ios/**

# Stale local CocoaPods/Xcode artifacts — exclude from EAS upload so remote
# workers regenerate Pods with correct paths (docs/TESTFLIGHT.md). Prevents
# ~400MB uploads and hardcoded-path failures when prebuild installs Pods locally.
apps/mobile/ios/Pods/
apps/mobile/ios/Podfile.lock
apps/mobile/ios/build/
apps/mobile/ios/*.xcworkspace/
