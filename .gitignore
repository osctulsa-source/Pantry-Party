# Dependencies
node_modules/
.pnp.*

# Build output
dist/
build/
*.tsbuildinfo

# Expo
.expo/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
ios/
android/
# @bacons/apple-targets regenerates this from expo-target.config.js on every
# prebuild — the Info.plist beside it is hand-authored and stays tracked.
apps/mobile/targets/*/generated.entitlements

# Env & secrets — NEVER commit
.env
.env.*
!.env.example

# Spike results (keep the dir, ignore the runs)
spikes/**/results/*.json

# PowerSync spike — throwaway config dir (can hold connection secrets) + local SQLite
.powersync/

# OS / editor
.DS_Store
*.log
.idea/
.vscode/*
!.vscode/extensions.json

# generated glyph QA sheet (regenerate via gen-glyph-sheet.mjs)
apps/mobile/scripts/glyph-sheet.html

# Isolated worktrees (superpowers workflow)
.worktrees/
