# Copy to .env and fill in. Open Food Facts needs no key.
# UPCitemdb trial endpoint works keyless at low volume; the production endpoint needs this.
UPCITEMDB_KEY=
# Paid fallback (Barcode Lookup, go-upc, etc.) — fill when wiring the third tier.
PAID_BARCODE_KEY=
# Receipt OCR vendor (Tabscanner or Veryfi). Needed only for the OCR half of the spike.
OCR_VENDOR=tabscanner
OCR_API_KEY=
