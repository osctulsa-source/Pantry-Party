{
  "expo": {
    "name": "Pantry Party",
    "slug": "pantry-party",
    "version": "0.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.osctulsa.pantryparty.dev"
    },
    "android": {
      "package": "com.osctulsa.pantryparty.dev",
      "adaptiveIcon": {
        "backgroundColor": "#F6F2E9"
      }
    },
    "plugins": [
      "expo-font",
      "expo-dev-client",
      [
        "expo-notifications",
        {
          "color": "#2E5D3A"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
