{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-native",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@breadbox/core": ["../../packages/core/src/index.ts"],
      "@/*": ["./src/*"]
    },
    "composite": false
  },
  "include": ["App.tsx", "src/**/*.ts", "src/**/*.tsx"],
  "//": "Test files are run by jest (Babel transform), not typechecked here — keeps the tsc job independent of jest/RNTL types. Add a tsconfig.test.json later if you want them typechecked.",
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
