{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-native",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@breadbox/core": ["../../packages/core/src/index.ts"],
      "@/*": ["./src/*"]
    },
    "composite": false
  },
  "include": ["App.tsx", "src/**/*.ts", "src/**/*.tsx"]
}
