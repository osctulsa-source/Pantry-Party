# Local-dev configuration for the mobile app.
# Copy to .env.local (gitignored) and fill in real values.
#
# Both vars must be prefixed with EXPO_PUBLIC_ so Expo exposes them to client JS.
# These are non-secret in production sense (the token IS auth) but should still
# be kept out of version control — JWTs expire, and they shouldn't be shared.

# PowerSync instance URL — local-dev runs at :8080
EXPO_PUBLIC_POWERSYNC_URL=http://localhost:8080

# Dev JWT — regenerate with the PowerSync CLI (`powersync generate-token`) if
# available, or via the Node fallback documented in infra/local-dev/README.md.
# Token typically expires in 12-24h. When the app stops syncing, regenerate.
EXPO_PUBLIC_POWERSYNC_TOKEN=
