# Local-dev configuration for the mobile app.
# Copy to .env.local (gitignored) and fill in real values.
#
# All vars must be prefixed with EXPO_PUBLIC_ so Expo exposes them to client JS.

# PowerSync instance URL — local-dev runs at :8080.
# Auth is now Supabase-driven: the mobile client forwards the Supabase access
# token from supabase.auth.getSession() as the PowerSync bearer token (see
# apps/mobile/src/data/powersync/db.ts). No static dev JWT needed anymore.
EXPO_PUBLIC_POWERSYNC_URL=http://localhost:8080

# NestJS API (services/api, ADR-009).
# Mobile client POSTs the PowerSync CRUD queue here (SupabaseConnector.uploadData)
# and uses the authenticated household/recipe/account endpoints.
# Match API_PORT in infra/local-dev/docker/.env. Default 8090.
EXPO_PUBLIC_API_URL=http://localhost:8090

# Spoonacular: the API key is SERVER-SIDE now — set SPOONACULAR_API_KEY in
# infra/local-dev/docker/.env (the api container reads it; see docker-compose).
# It must never appear in client JS again: a bundled key is extractable in
# minutes and one bad actor burns the shared daily quota for everyone.
# Sign up at https://spoonacular.com/food-api

# Supabase project URL + anon key (from Project Settings → API).
# anon key is safe to ship in client JS — RLS enforces actual access control.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Sentry (optional, recommended before any external users) — create a
# React Native project at sentry.io and paste its DSN here. Unset = error
# reporting disabled (the app logs a note and runs normally).
EXPO_PUBLIC_SENTRY_DSN=

# PostHog (optional) — project API key from https://app.posthog.com
# (Project Settings → Project API Key). Unset = product analytics disabled.
# Host is usually https://us.i.posthog.com or https://eu.i.posthog.com.
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
